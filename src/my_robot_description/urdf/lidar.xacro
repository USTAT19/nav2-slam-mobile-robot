<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="lidar_radius" value="0.035" />
    <xacro:property name="lidar_length" value="0.04" />

    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}" />
            </geometry>
        </collision>
        <xacro:cylindrical_inertia m="0.1" r="${lidar_radius}" h="${lidar_length}"
                                   o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="base_laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser_link" />
        <origin xyz="${(base_length / 2.0) - 0.05} 0 ${base_height + lidar_length / 2.0}" rpy="0 0 0" />
    </joint>

    <gazebo reference="laser_link">
        <sensor name="lidar" type="gpu_lidar">
            <gz_frame_id>laser_link</gz_frame_id>
            <topic>scan</topic>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-2.356194</min_angle>
                        <max_angle>2.356194</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>


    <gazebo reference="base_laser_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    
</robot>